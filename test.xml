<mxfile host="app.diagrams.net">
  <diagram name="AWS Architecture Clean">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Developer -->
        <mxCell id="dev" value="Developer" style="ellipse;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="120" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="github" value="GitHub Repo" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="160" y="40" width="150" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="actions" value="GitHub Actions&#xa;Build + Test + Dockerize" style="rounded=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="330" y="30" width="220" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ecr" value="Amazon ECR&#xa;(Frontend + Backend Images)" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- VPC -->
        <mxCell id="vpc" value="VPC" style="rounded=1;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="1100" height="650" as="geometry"/>
        </mxCell>

        <!-- Public Subnet -->
        <mxCell id="public" value="Public Subnet" style="rounded=1;fillColor=#ffe6cc;" vertex="1" parent="vpc">
          <mxGeometry x="40" y="40" width="480" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="alb" value="ALB" style="rounded=1;fillColor=#ff9933;" vertex="1" parent="public">
          <mxGeometry x="150" y="70" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="tg1" value="Target Group (Frontend)" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="public">
          <mxGeometry x="60" y="160" width="180" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="tg2" value="Target Group (Backend)" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="public">
          <mxGeometry x="260" y="160" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- Private Subnet -->
        <mxCell id="private" value="Private Subnet" style="rounded=1;fillColor=#e1d5e7;" vertex="1" parent="vpc">
          <mxGeometry x="560" y="40" width="480" height="420" as="geometry"/>
        </mxCell>

        <mxCell id="ecs_front" value="ECS Service Frontend&#xa;(React + IAM Role)" style="rounded=1;fillColor=#dae8fc;" vertex="1" parent="private">
          <mxGeometry x="40" y="60" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="ecs_back" value="ECS Service Backend&#xa;(FastAPI + IAM Role)" style="rounded=1;fillColor=#dae8fc;" vertex="1" parent="private">
          <mxGeometry x="260" y="60" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="rds" value="Amazon RDS PostgreSQL" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="private">
          <mxGeometry x="150" y="200" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- User -->
        <mxCell id="user" value="User" style="ellipse;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="900" y="40" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- CI/CD Flow -->
        <mxCell edge="1" source="dev" target="github" style="endArrow=block;" parent="1"/>
        <mxCell edge="1" source="github" target="actions" style="endArrow=block;" parent="1"/>
        <mxCell edge="1" source="actions" target="ecr" style="endArrow=block;" parent="1"/>

        <!-- Image Pull -->
        <mxCell edge="1" source="ecr" target="ecs_front" style="dashed=1;endArrow=block;" parent="1"/>
        <mxCell edge="1" source="ecr" target="ecs_back" style="dashed=1;endArrow=block;" parent="1"/>

        <!-- Traffic -->
        <mxCell edge="1" source="user" target="alb" style="endArrow=block;" parent="1"/>
        <mxCell edge="1" source="alb" target="tg1" style="endArrow=block;" parent="1"/>
        <mxCell edge="1" source="alb" target="tg2" style="endArrow=block;" parent="1"/>

        <mxCell edge="1" source="tg1" target="ecs_front" style="endArrow=block;" parent="1"/>
        <mxCell edge="1" source="tg2" target="ecs_back" style="endArrow=block;" parent="1"/>

        <!-- App Flow -->
        <mxCell edge="1" source="ecs_front" target="ecs_back" style="endArrow=block;" parent="1"/>
        <mxCell edge="1" source="ecs_back" target="rds" style="endArrow=block;" parent="1"/>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>